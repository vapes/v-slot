{
  "name": "v-slot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit && node scripts/check.mjs",
    "new-game": "node scripts/new-game.mjs",
    "thumbnails": "node scripts/make-thumbnails.cjs",
    "classic:screens": "node src/games/classic/tools/generate-screens.mjs",
    "classic:rtp": "tsx src/games/classic/tools/demo-rtp.ts",
    "dragon:reels": "node src/games/dragon/tools/build-reels.mjs",
    "dragon:slice": "python3 src/games/dragon/tools/slice-skin.py",
    "dragon:video": "python3 src/games/dragon/tools/make-video-bg.py",
    "classic:slice": "python3 src/games/classic/tools/slice-skin.py",
    "dragon:sim": "tsx src/games/dragon/tools/simulate.ts",
    "crystal:sim": "tsx src/games/crystal/tools/simulate.ts",
    "crystal:art": "python3 src/games/crystal/tools/draw-symbols.py && python3 src/games/crystal/tools/draw-skin.py",
    "test": "vitest run",
    "qa": "node scripts/qa.cjs"
  },
  "dependencies": {
    "pixi.js": "^8.23.0"
  },
  "devDependencies": {
    "jsdom": "^25.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vitest": "^2.1.9"
  }
}
